# .env.local にコピーして値を入れる（.env.local はコミットしない）
# Amazon アソシエイトのトラッキング ID
NEXT_PUBLIC_AMAZON_TAG=yourname-22
# 公開先の URL（サイトマップ・OGP に使う）。任意。Vercel では未設定でも本番 URL が自動で使われる
NEXT_PUBLIC_SITE_URL=https://example.com
# Google アナリティクスの測定 ID（G- で始まる）。Vercel の環境変数にも同じ値を入れる
NEXT_PUBLIC_GA_ID=
# Google Search Console の所有権確認（HTML タグの content="…" の値だけを入れる）。Vercel の環境変数にも同じ値を入れる
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 記事の下書き生成（npm run draft）で使う Claude API のキー。NEXT_PUBLIC_ を付けないこと（付けると公開ページに埋め込まれる）
ANTHROPIC_API_KEY=
